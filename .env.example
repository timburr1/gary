# Discord bot token (Developer Portal > your app > Bot > Reset Token)
DISCORD_TOKEN=
# Channel where plain chat goes to the GM (right-click channel > Copy Channel ID)
GAME_CHANNEL_ID=
# Server ID; registers /roll instantly instead of waiting up to an hour for global sync
GUILD_ID=
# Billed per token. Without it, Claude Code uses whatever account it's logged in with.
ANTHROPIC_API_KEY=
# Optional: Claude Code model alias or full ID for the GM and NPCs (default: opus)
# GARY_MODEL=sonnet
# Optional: where LoreKit keeps the campaign database (default: ./campaign)
# GARY_CAMPAIGN_DIR=
